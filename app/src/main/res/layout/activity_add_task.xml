<?xml version="1.0" encoding="utf-8"?>

<!-- Add task page -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_purple"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".AddTaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_background"
        android:orientation="vertical">

        <!-- Page header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@color/primary_purple">

            <!-- Page title -->
            <TextView
                android:id="@+id/txtAddTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/add_task_title"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:padding="14dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Add task page icon -->
        <ImageView
            android:id="@+id/imgAddTaskIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/add_task_icon_background"
            android:contentDescription="@string/add_task_icon_description"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/add_task_icon" />

        <!-- Form section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Task title label -->
            <TextView
                android:id="@+id/txtTaskTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/task_title"
                android:textColor="@color/main_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Task title input -->
            <EditText
                android:id="@+id/editTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input_background"
                android:hint="@string/task_title_hint"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/main_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="16sp" />

            <!-- Description label -->
            <TextView
                android:id="@+id/txtDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/description"
                android:textColor="@color/main_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description input -->
            <EditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input_background"
                android:gravity="top"
                android:hint="@string/description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textColor="@color/main_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="16sp" />

            <!-- Priority label -->
            <TextView
                android:id="@+id/txtPriorityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/priority"
                android:textColor="@color/main_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Priority box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input_background">

                <!-- Priority dropdown -->
                <Spinner
                    android:id="@+id/spinnerPriority"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:entries="@array/priority_options"
                    android:paddingStart="12dp"
                    android:paddingEnd="42dp"
                    android:spinnerMode="dropdown" />

                <!-- Dropdown arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/arrow_down_float" />

            </FrameLayout>

            <!-- Add task button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTask"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="35dp"
                android:text="@string/add_task"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_purple"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>